---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="Page not found.">
  <section class="shell flex min-h-[50vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-mono text-sm text-accent-ink">404</p>
    <h1 class="mt-3 text-3xl tracking-tight sm:text-4xl">This page wandered off.</h1>
    <p class="mt-3 font-sans text-sm text-muted">The link may be broken or the page may have moved.</p>
    <a href="/" class="mt-7 rounded-full bg-ink px-5 py-2.5 font-sans text-sm text-bg transition-colors hover:bg-accent-ink">
      Back home
    </a>
  </section>
</BaseLayout>
