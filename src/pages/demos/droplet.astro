---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { DEMOS } from '../../data/demos';

const demo = DEMOS.find((d) => d.href === '/demos/droplet')!;

// The wasm build lives in /public, so these are plain runtime URLs, not imports.
// droplet.js resolves droplet.wasm relative to its own directory, so both must stay
// side by side in public/games/droplet/. Rebuild with `sh build-web.sh` in the game
// repo and re-copy all four files.
const GAME_JS = '/games/droplet/droplet.js';
const GAME_DIR = '/games/droplet/';
---

<BaseLayout
  title={demo.title}
  description="A sprite-based arcade game written in C++ for a NES-class display, compiled to WebAssembly and playable in the browser."
>
  <!-- one 520px column, centred on the page: the canvas is 520 wide, so everything
       lines up with it instead of with the page gutter -->
  <div class="mx-auto w-full max-w-[520px] px-4 pt-16 pb-16 sm:pt-20">
    <p class="eyebrow text-center">Demo</p>
    <h1 class="mt-4 text-center text-3xl tracking-tight sm:text-4xl">{demo.title}</h1>
    <p class="mt-3 text-center font-sans text-lg text-accent-ink italic">“You Are Bugs!”</p>

    <div class="mt-6 flex flex-wrap justify-center gap-1.5">
      {demo.stack.map((s) => <Tag label={s} />)}
    </div>

    <canvas id="canvas" tabindex="-1" oncontextmenu="event.preventDefault()" class="mt-8"></canvas>
    <p id="status" class="mt-3 text-center font-mono text-xs text-muted">Loading…</p>

    <p class="mt-6 font-sans text-base leading-relaxed text-muted">
      Use <kbd>←</kbd> <kbd>→</kbd> <kbd>↑</kbd> <kbd>↓</kbd> to hunt down those puny humans. Catch
      as many ships as you can before the 60 seconds run out, then press <kbd>R</kbd> to hunt again.
      Click the canvas first if the keys do nothing.
    </p>

    <img
      src={`${GAME_DIR}screenshot-win.png`}
      width="1082"
      height="1070"
      alt="End screen after a winning round"
      class="mx-auto mt-8 w-full max-w-[300px] rounded-lg border border-line [image-rendering:pixelated]"
    />

    <p class="mt-8 font-sans text-base leading-relaxed text-muted">
      The game is written in C++ on top of OpenGL, then compiled to WebAssembly and embedded in the
      browser with HTML and JavaScript. The whole idea is to build a game, asset pipeline included,
      for a display as constrained as the
      <a href="https://www.nesdev.org/wiki/PPU" rel="noopener" class="text-accent-ink hover:text-ink"
        >Nintendo Entertainment System's PPU</a
      >: 8x8 tiles, four colours per tile, and 64 sprites on screen.
    </p>
    <p class="mt-3 font-sans text-base leading-relaxed text-muted">
      Source code on
      <a href={demo.github} rel="noopener" class="text-accent-ink hover:text-ink">GitHub</a>.
    </p>

    <div class="mt-8 font-sans text-sm leading-relaxed text-muted">
      <p>
        Inspired by
        <a href="https://www.3body.com/" rel="noopener" class="text-accent-ink hover:text-ink"
          >The Three-Body Problem II: The Dark Forest</a
        >
        by
        <a href="https://en.wikipedia.org/wiki/Liu_Cixin" rel="noopener" class="text-accent-ink hover:text-ink"
          >Cixin Liu</a
        >.
      </p>
      <p>
        Built with
        <a href={`${demo.github}/blob/main/NEST.md`} rel="noopener" class="text-accent-ink hover:text-ink"
          >NEST</a
        >.
      </p>
      <p>
        All sprites and the background were drawn in
        <a href="https://www.aseprite.org/" rel="noopener" class="text-accent-ink hover:text-ink">Aseprite</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  /* SDL writes the backing-store size onto the canvas element, so give it a fixed
     CSS box instead of height:auto, or the two derive their size from each other
     and settle at 0, which renders as a black rectangle. */
  #canvas {
    display: block;
    width: 100%;
    max-width: 520px; /* the size main.cpp asks SDL for: 2*256+8 */
    height: 488px;
    background: #000;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    image-rendering: pixelated; /* the PPU output is 256x240; keep it crisp when scaled */
    outline: none;
    touch-action: none;
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-bottom-width: 2px;
    border-radius: 3px;
    padding: 0.1em 0.4em;
    color: var(--color-ink);
  }
</style>

<!-- is:inline on both: Astro must not bundle or rewrite these. The first defines the
     object emscripten reads on startup, the second is the generated glue, and it only
     works if it runs after the first. -->
<script is:inline>
  (function () {
    var statusElement = document.getElementById('status');
    var canvasElement = document.getElementById('canvas');

    window.Module = {
      canvas: canvasElement,
      print: function (text) { console.log(text); },
      printErr: function (text) { console.error(text); },
      setStatus: function (text) {
        //emscripten calls this with '' once the wasm is running:
        statusElement.textContent = text;
        statusElement.style.display = text === '' ? 'none' : '';
      },
    };

    //the arrow keys scroll the page by default, which fights the game:
    window.addEventListener('keydown', function (e) {
      if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].indexOf(e.key) !== -1) {
        e.preventDefault();
      }
    }, false);

    //SDL reads keys from the focused element, so hand it focus on click:
    canvasElement.addEventListener('click', function () { canvasElement.focus(); });
  })();
</script>
<script is:inline src={GAME_JS}></script>
