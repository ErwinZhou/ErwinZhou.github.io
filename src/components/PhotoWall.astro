---
import { PHOTOS } from '../data/photos';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Import the originals for Astro's build-time optimizer while keeping their
// existing public URLs for full-size lightbox viewing.
const originals = import.meta.glob<{ default: ImageMetadata }>(
  '../../public/images/life/*.{jpeg,jpg,JPG}',
  { eager: true },
);
---

<!-- Static flush grid, tiles pieced together edge-to-edge like a puzzle -->
<div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-5">
  {
    PHOTOS.map((photo) => (
      <button
        type="button"
        class="photo-tile block aspect-square overflow-hidden bg-surface focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset"
        data-lightbox
        data-src={photo.src}
        data-caption={photo.caption}
        aria-label={`View photo: ${photo.caption}`}
      >
        <Image
          src={originals[`../../public${photo.src}`].default}
          alt={photo.alt}
          width={720}
          height={720}
          widths={[240, 480, 720]}
          sizes="(min-width: 1088px) 208px, (min-width: 1024px) calc((100vw - 48px) / 5), (min-width: 640px) calc((100vw - 48px) / 4), calc((100vw - 48px) / 3)"
          fit="cover"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </button>
    ))
  }
</div>

<!-- Lightbox -->
<dialog
  id="lightbox"
  class="m-auto max-h-[92vh] max-w-[92vw] bg-transparent backdrop:bg-ink/80 backdrop:backdrop-blur-sm"
>
  <figure class="flex flex-col items-center gap-3">
    <button type="button" data-close-lightbox class="self-end rounded-full bg-bg px-3 py-1 font-sans text-sm text-ink" aria-label="Close photo">Close ×</button>
    <img id="lightbox-img" src="" alt="" class="max-h-[80vh] max-w-full rounded-xl" />
    <figcaption id="lightbox-cap" class="font-sans text-sm text-bg"></figcaption>
  </figure>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const cap = document.getElementById('lightbox-cap');

  if (dialog && img && cap) {
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((btn) => {
      const thumbnail = btn.querySelector('img');
      if (thumbnail && !thumbnail.complete) {
        btn.classList.add('is-loading');
        const reveal = () => btn.classList.remove('is-loading');
        thumbnail.addEventListener('load', reveal, { once: true });
        thumbnail.addEventListener('error', reveal, { once: true });
      }
      btn.addEventListener('click', () => {
        const source = btn.dataset.src ?? '';
        // Show the already-loaded thumbnail immediately; fetch the original
        // only after a visitor opens it, then swap it in without a blank frame.
        img.src = thumbnail?.currentSrc || source;
        img.alt = btn.dataset.caption ?? '';
        img.dataset.source = source;
        cap.textContent = btn.dataset.caption ?? '';
        dialog.showModal();
        const fullSize = new window.Image();
        fullSize.onload = () => {
          if (dialog.open && img.dataset.source === source) img.src = source;
        };
        fullSize.src = source;
      });
    });
    dialog.querySelector('[data-close-lightbox]')?.addEventListener('click', () => dialog.close());
    // Click on backdrop closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .photo-tile img {
    opacity: 1;
    transition: opacity 180ms ease-out;
  }
  .photo-tile.is-loading img {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-tile img { transition: none; }
  }
</style>
