---
import { SKILLS } from '../data/experience';
import * as simpleIcons from 'simple-icons';

// Two ways to supply an icon, keyed by skill name:
//   1. A simple-icons slug (see https://simpleicons.org for the full catalog + names) — renders
//      as a monochrome SVG tinted with the page's ink color.
//   2. An image path pointing at a file in public/images/icons/ (e.g. '/images/icons/aws.jpg') —
//      any raster or vector image (.jpg, .jpeg, .png, .webp, .svg, .gif) is detected by its
//      extension and scaled to fit within ~80% of the circle (never cropped).
// Anything left unmapped falls back to an initials badge (see badgeLabel below).
type IconRef = keyof typeof simpleIcons | string;

const IMAGE_EXT = /\.(png|jpe?g|webp|gif|svg)$/i;

const DEVICON = 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons';
const ICONS = '/images/icons';

const ICON_SLUGS: Record<string, IconRef> = {
  // Programming Languages
  'C++': `${DEVICON}/cplusplus/cplusplus-original.svg`,
  C: `${ICONS}/c.svg`,
  Python: `${DEVICON}/python/python-original.svg`,
  Java: `${ICONS}/java.svg`,
  Go: `${ICONS}/go.svg`,
  Rust: `${DEVICON}/rust/rust-original.svg`,
  SQL: `${DEVICON}/mysql/mysql-original.svg`,
  Shell: `${DEVICON}/bash/bash-original.svg`,
  JavaScript: `${ICONS}/javascript.svg`,
  TypeScript: `${ICONS}/typescript.svg`,
  React: `${ICONS}/react.svg`,
  CSS3: `${ICONS}/css3.svg`,
  HTML5: `${ICONS}/html5.svg`,
  Markdown: `${ICONS}/markdown.svg`,
  'Node.js': `${ICONS}/nodejs.svg`,
  HCL: `${ICONS}/hcl.svg`,

  // Cloud
  AWS: `${DEVICON}/amazonwebservices/amazonwebservices-original-wordmark.svg`,
  'Amazon Bedrock': `${ICONS}/aws-amazon-bedrock.svg`,
  'Amazon EventBridge': `${ICONS}/aws-amazon-eventbridge.svg`,
  'AWS Fargate': `${ICONS}/aws-aws-fargate.svg`,
  'AWS Lambda': `${ICONS}/aws-aws-lambda.svg`,
  GCP: `${DEVICON}/googlecloud/googlecloud-original.svg`,
  'GCP Compute Engine': `${ICONS}/gcp-compute-engine.svg`,
  'Google Kubernetes Engine': `${ICONS}/gcp-google-kubernetes-engine.svg`,
  DynamoDB: `${DEVICON}/dynamodb/dynamodb-original.svg`,
  Kubernetes: `${DEVICON}/kubernetes/kubernetes-plain.svg`,
  Terraform: `${DEVICON}/terraform/terraform-original.svg`,
  Docker: `${DEVICON}/docker/docker-original.svg`,
  Microservices: `${ICONS}/k8s-service.svg`,

  // Tools
  Git: `${ICONS}/git.svg`,
  Redis: `${DEVICON}/redis/redis-original.svg`,
  Kafka: `${DEVICON}/apachekafka/apachekafka-original.svg`,
  'Hadoop / MapReduce': `${DEVICON}/hadoop/hadoop-original.svg`,
  ClickHouse: `${ICONS}/clickhouse.svg`,
  FastAPI: `${DEVICON}/fastapi/fastapi-original.svg`,
  PostgreSQL: `${DEVICON}/postgresql/postgresql-original.svg`,
  Neo4J: `${DEVICON}/neo4j/neo4j-original.svg`,
  PyTorch: `${DEVICON}/pytorch/pytorch-original.svg`,
  TensorFlow: `${ICONS}/tensorflow.svg`,
  HuggingFace: `${ICONS}/hugging-face.svg`,
  MCP: `${ICONS}/model-context-protocol.svg`,
  GitHub: `${ICONS}/github.svg`,
  Linux: `${ICONS}/linux.svg`,
  'Claude Code': `${ICONS}/claude-code.svg`,
  Codex: `${ICONS}/codex.svg`,
};

type Icon = { kind: 'svg'; path: string } | { kind: 'image'; src: string };

function iconFor(name: string): Icon | null {
  const ref = ICON_SLUGS[name];
  if (!ref) return null;
  if (IMAGE_EXT.test(ref)) return { kind: 'image', src: ref };
  const path = simpleIcons[ref as keyof typeof simpleIcons]?.path;
  return path ? { kind: 'svg', path } : null;
}

function badgeLabel(name: string): string {
  const clean = name.split('(')[0].trim();
  if (clean.length <= 4) return clean;
  const words = clean.split(/[\s/]+/).filter(Boolean);
  if (words.length >= 2) return words.map((w) => w[0]).join('').toUpperCase().slice(0, 3);
  return clean.slice(0, 3);
}

// Full names ("AWS (Bedrock, S3, ECS Fargate)") are too long for the back face — trim to the headline term.
function displayName(name: string): string {
  return name.split('(')[0].trim();
}

const sections = SKILLS.map((group) => ({
  ...group,
  items: group.items.map((item) => ({ item, icon: iconFor(item) })),
}));
---

<div class="skills-grid space-y-10">
  {
    sections.map((section) => (
      <div class="skill-section">
        <h3 data-reveal class="skill-section-title font-sans text-sm font-semibold uppercase tracking-wide text-muted">
          {section.group}
        </h3>
        <div class="mt-4 grid grid-cols-4 gap-4 sm:grid-cols-6 sm:gap-5 lg:grid-cols-8">
          {section.items.map(({ item, icon }, i) => (
            <div class="skill-cell" data-reveal={i % 2 === 0 ? 'left' : 'right'} style={`transition-delay: ${i * 45}ms`}>
              <button
                type="button"
                data-skill
                aria-pressed="false"
                aria-label={`${item} — ${section.group}`}
                class="skill-card"
              >
                <span class="skill-face skill-face--front" aria-hidden="true">
                  {icon?.kind === 'svg' ? (
                    <svg viewBox="0 0 24 24" fill="currentColor" class="skill-icon" set:html={`<path d="${icon.path}" />`} />
                  ) : icon?.kind === 'image' ? (
                    <img src={icon.src} alt="" class="skill-icon skill-icon--image" loading="lazy" />
                  ) : (
                    <span class="skill-fallback">{badgeLabel(item)}</span>
                  )}
                </span>
                <span class="skill-face skill-face--back" aria-hidden="true">
                  <span class="skill-name">{displayName(item)}</span>
                  <span class="skill-group">{section.group}</span>
                </span>
              </button>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>

<script>
  const grid = document.querySelector('.skills-grid');
  grid?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-skill]');
    if (!button) return;
    const isOpen = button.getAttribute('aria-pressed') === 'true';
    button.setAttribute('aria-pressed', String(!isOpen));
  });
</script>

<style>
  .skill-cell {
    perspective: 900px;
    display: flex;
    justify-content: center;
  }

  .skill-card {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    transform-style: preserve-3d;
    transition: transform 260ms cubic-bezier(0.77, 0, 0.175, 1);
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .skill-card {
      width: 5rem;
      height: 5rem;
    }
  }

  .skill-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 9999px;
    border: 2px solid var(--color-line);
    background: var(--color-surface);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .skill-face--back {
    transform: rotateY(180deg);
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.4rem;
    text-align: center;
  }

  .skill-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .skill-icon {
      width: 2rem;
      height: 2rem;
    }
  }

  .skill-icon--image {
    width: 80%;
    height: 80%;
    object-fit: contain;
  }

  .skill-fallback {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .skill-fallback {
      font-size: 0.875rem;
    }
  }

  .skill-name {
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .skill-group {
    font-family: var(--font-sans);
    font-size: 0.45rem;
    line-height: 1.1;
    opacity: 0.85;
  }

  @media (min-width: 640px) {
    .skill-name {
      font-size: 0.7rem;
    }
    .skill-group {
      font-size: 0.55rem;
    }
  }

  .skill-card[aria-pressed='true'] {
    transform: rotateY(180deg);
  }

  .skill-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 9999px;
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-card:hover {
      transform: rotateY(180deg);
    }
  }
</style>
