---
import { SKILLS } from '../data/experience';
import * as simpleIcons from 'simple-icons';

// Two ways to supply an icon:
//   1. A simple-icons slug (see https://simpleicons.org for the full catalog + names).
//   2. A raw { path } for anything not in simple-icons — grab the SVG's <path d="..."> from
//      an official brand kit or icon set, viewBox 24x24, and paste it as `{ path: '...' }`.
// Anything left unmapped falls back to an initials badge (see badgeLabel below).
type IconRef = keyof typeof simpleIcons | { path: string };

const ICON_SLUGS: Record<string, IconRef> = {
  'C++': 'siCplusplus',
  Python: 'siPython',
  Java: 'siOpenjdk',
  Go: 'siGo',
  C: 'siC',
  Rust: 'siRust',
  Shell: 'siGnubash',
  HCL: 'siHcl',
  Docker: 'siDocker',
  Kubernetes: 'siKubernetes',
  Terraform: 'siTerraform',
  Redis: 'siRedis',
  Kafka: 'siApachekafka',
  'Hadoop / MapReduce': 'siApachehadoop',
  FastAPI: 'siFastapi',
  PostgreSQL: 'siPostgresql',
  MySQL: 'siMysql',
  Neo4J: 'siNeo4j',
  GCP: 'siGooglecloud',
  PyTorch: 'siPytorch',
  'Claude Code': 'siAnthropic',

  // --- TODO: not in simple-icons (or no real brand mark) — fill in a { path: '...' } above ---
  // SQL: { path: '' },
  // 'Distributed Systems': { path: '' },
  // 'System Design': { path: '' },
  // 'Database Internals': { path: '' },
  // Microservices: { path: '' },
  // 'Concurrency Control': { path: '' },
  // 'CI/CD': { path: '' },
  // DynamoDB: { path: '' },
  // 'AWS (Bedrock, S3, ECS Fargate)': { path: '' },
  // MCP: { path: '' },
  // Codex: { path: '' },
};

function iconPath(name: string): string | null {
  const ref = ICON_SLUGS[name];
  if (!ref) return null;
  if (typeof ref === 'string') return simpleIcons[ref]?.path ?? null;
  return ref.path || null;
}

function badgeLabel(name: string): string {
  const clean = name.split('(')[0].trim();
  if (clean.length <= 4) return clean;
  const words = clean.split(/[\s/]+/).filter(Boolean);
  if (words.length >= 2) return words.map((w) => w[0]).join('').toUpperCase().slice(0, 3);
  return clean.slice(0, 3);
}

// Full names ("AWS (Bedrock, S3, ECS Fargate)") are too long for the back face — trim to the headline term.
function displayName(name: string): string {
  return name.split('(')[0].trim();
}

const flat = SKILLS.flatMap((group) =>
  group.items.map((item) => ({ group: group.group, item, icon: iconPath(item) })),
);

const half = Math.ceil(flat.length / 2);
---

<div class="skills-grid grid grid-cols-4 gap-4 sm:grid-cols-6 sm:gap-5 lg:grid-cols-8">
  {
    flat.map(({ group, item, icon }, i) => (
      <div
        class="skill-cell"
        data-reveal={i < half ? 'left' : 'right'}
        style={`transition-delay: ${(i % half) * 45}ms`}
      >
        <button
          type="button"
          data-skill
          aria-pressed="false"
          aria-label={`${item} — ${group}`}
          class="skill-card"
        >
          <span class="skill-face skill-face--front" aria-hidden="true">
            {icon ? (
              <svg viewBox="0 0 24 24" fill="currentColor" class="skill-icon" set:html={`<path d="${icon}" />`} />
            ) : (
              <span class="skill-fallback">{badgeLabel(item)}</span>
            )}
          </span>
          <span class="skill-face skill-face--back" aria-hidden="true">
            <span class="skill-name">{displayName(item)}</span>
            <span class="skill-group">{group}</span>
          </span>
        </button>
      </div>
    ))
  }
</div>

<script>
  const grid = document.querySelector('.skills-grid');
  grid?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-skill]');
    if (!button) return;
    const isOpen = button.getAttribute('aria-pressed') === 'true';
    button.setAttribute('aria-pressed', String(!isOpen));
  });
</script>

<style>
  .skill-cell {
    perspective: 900px;
    display: flex;
    justify-content: center;
  }

  .skill-card {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    transform-style: preserve-3d;
    transition: transform 260ms cubic-bezier(0.77, 0, 0.175, 1);
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .skill-card {
      width: 5rem;
      height: 5rem;
    }
  }

  .skill-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 2px solid var(--color-line);
    background: var(--color-surface);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .skill-face--back {
    transform: rotateY(180deg);
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.4rem;
    text-align: center;
  }

  .skill-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .skill-icon {
      width: 2rem;
      height: 2rem;
    }
  }

  .skill-fallback {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .skill-fallback {
      font-size: 0.875rem;
    }
  }

  .skill-name {
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .skill-group {
    font-family: var(--font-sans);
    font-size: 0.45rem;
    line-height: 1.1;
    opacity: 0.85;
  }

  @media (min-width: 640px) {
    .skill-name {
      font-size: 0.7rem;
    }
    .skill-group {
      font-size: 0.55rem;
    }
  }

  .skill-card[aria-pressed='true'] {
    transform: rotateY(180deg);
  }

  .skill-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 9999px;
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-card:hover {
      transform: rotateY(180deg);
    }
  }
</style>
