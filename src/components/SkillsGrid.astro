---
import { SKILLS } from '../data/experience';
import * as simpleIcons from 'simple-icons';

// Two ways to supply an icon, keyed by skill name:
//   1. A simple-icons slug (see https://simpleicons.org for the full catalog + names) — renders
//      as a monochrome SVG tinted with the page's ink color.
//   2. An image path pointing at a file in public/images/icons/ (e.g. '/images/icons/aws.jpg') —
//      any raster or vector image (.jpg, .jpeg, .png, .webp, .svg, .gif) is detected by its
//      extension and scaled to fit within ~80% of the circle (never cropped).
// Anything left unmapped falls back to an initials badge (see badgeLabel below).
type IconRef = keyof typeof simpleIcons | string;

const IMAGE_EXT = /\.(png|jpe?g|webp|gif|svg)$/i;

const DEVICON = 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons';
const ICONS = '/images/icons';

const ICON_SLUGS: Record<string, IconRef> = {
  // Programming Languages
  SQL: `${DEVICON}/mysql/mysql-original.svg`,
  Shell: `${DEVICON}/bash/bash-original.svg`,
  Rust: `${DEVICON}/rust/rust-original.svg`,
  TypeScript: `${ICONS}/typescript.svg`,
  JavaScript: `${ICONS}/javascript.svg`,
  C: `${ICONS}/c.svg`,
  'C++': `${DEVICON}/cplusplus/cplusplus-original.svg`,
  Python: `${DEVICON}/python/python-original.svg`,
  Java: `${ICONS}/java.svg`,
  Go: `${ICONS}/go.svg`,

  // Cloud
  'GCP Compute Engine': `${ICONS}/gcp-compute-engine.svg`,
  'Google Kubernetes Engine': `${ICONS}/gcp-google-kubernetes-engine.svg`,
  Microservices: `${ICONS}/k8s-service.svg`,
  Kubernetes: `${DEVICON}/kubernetes/kubernetes-plain.svg`,
  Terraform: `${DEVICON}/terraform/terraform-original.svg`,
  AWS: `${DEVICON}/amazonwebservices/amazonwebservices-original-wordmark.svg`,
  Docker: `${DEVICON}/docker/docker-original.svg`,
  GCP: `${DEVICON}/googlecloud/googlecloud-original.svg`,
  'Amazon Bedrock': `${ICONS}/aws-amazon-bedrock.svg`,
  'Amazon EventBridge': `${ICONS}/aws-amazon-eventbridge.svg`,
  'AWS Lambda': `${ICONS}/aws-aws-lambda.svg`,
  'AWS Fargate': `${ICONS}/aws-aws-fargate.svg`,

  // Tools
  PyTorch: `${DEVICON}/pytorch/pytorch-original.svg`,
  MCP: `${ICONS}/model-context-protocol.svg`,
  Kafka: `${DEVICON}/apachekafka/apachekafka-original.svg`,
  'Hadoop / MapReduce': `${DEVICON}/hadoop/hadoop-original.svg`,
  ClickHouse: `${ICONS}/clickhouse.svg`,
  'Claude Code': `${ICONS}/claude-code.svg`,
  Git: `${ICONS}/git.svg`,
  Codex: `${ICONS}/codex.svg`,
  FastAPI: `${DEVICON}/fastapi/fastapi-original.svg`,
  PostgreSQL: `${DEVICON}/postgresql/postgresql-original.svg`,
  Neo4J: `${DEVICON}/neo4j/neo4j-original.svg`,
  Redis: `${DEVICON}/redis/redis-original.svg`,
};

// Row 3 is the visual center; each column's items sit as close to it as symmetry allows.
const ROW_SLOTS: Record<number, number[]> = {
  1: [3],
  2: [2, 4],
  3: [2, 3, 4],
  4: [1, 2, 4, 5],
  5: [1, 2, 3, 4, 5],
};

type Icon = { kind: 'svg'; path: string } | { kind: 'image'; src: string };

function iconFor(name: string): Icon | null {
  const ref = ICON_SLUGS[name];
  if (!ref) return null;
  if (IMAGE_EXT.test(ref)) return { kind: 'image', src: ref };
  const path = simpleIcons[ref as keyof typeof simpleIcons]?.path;
  return path ? { kind: 'svg', path } : null;
}

function badgeLabel(name: string): string {
  const clean = name.split('(')[0].trim();
  if (clean.length <= 4) return clean;
  const words = clean.split(/[\s/]+/).filter(Boolean);
  if (words.length >= 2) return words.map((w) => w[0]).join('').toUpperCase().slice(0, 3);
  return clean.slice(0, 3);
}

// Full names ("AWS (Bedrock, S3, ECS Fargate)") are too long for the back face — trim to the headline term.
function displayName(name: string): string {
  return name.split('(')[0].trim();
}

const sections = SKILLS.map((group) => ({
  ...group,
  items: group.items.map((item) => ({ item, icon: iconFor(item) })),
}));

// Slice each group's flat item list into its columns (per `columns` counts) for the wedge grid,
// with each column's items assigned to symmetric row slots around the center row.
const wedgeSections = SKILLS.map((group) => {
  let cursor = 0;
  const columns = group.columns.map((count) => {
    const items = group.items.slice(cursor, cursor + count).map((item) => ({ item, icon: iconFor(item) }));
    cursor += count;
    return { items, rows: ROW_SLOTS[count] };
  });
  return { group: group.group, columns };
});
---

{/* Below md: a plain stacked list — the wedge shape needs room the triangles don't have on narrow screens. */}
<div class="skills-grid space-y-10 md:hidden">
  {
    sections.map((section) => (
      <div class="skill-section">
        <h3 data-reveal class="skill-section-title font-sans text-sm font-semibold uppercase tracking-wide text-muted">
          {section.group}
        </h3>
        <div class="mt-4 grid grid-cols-4 gap-4 sm:grid-cols-6 sm:gap-5">
          {section.items.map(({ item, icon }, i) => (
            <div class="skill-cell" data-reveal={i % 2 === 0 ? 'left' : 'right'} style={`transition-delay: ${i * 45}ms`}>
              <button
                type="button"
                data-skill
                aria-pressed="false"
                aria-label={`${item} — ${section.group}`}
                class="skill-card"
              >
                <span class="skill-face skill-face--front" aria-hidden="true">
                  {icon?.kind === 'svg' ? (
                    <svg viewBox="0 0 24 24" fill="currentColor" class="skill-icon" set:html={`<path d="${icon.path}" />`} />
                  ) : icon?.kind === 'image' ? (
                    <img src={icon.src} alt="" class="skill-icon skill-icon--image" loading="lazy" />
                  ) : (
                    <span class="skill-fallback">{badgeLabel(item)}</span>
                  )}
                </span>
                <span class="skill-face skill-face--back" aria-hidden="true">
                  <span class="skill-name">{displayName(item)}</span>
                  <span class="skill-group">{section.group}</span>
                </span>
              </button>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>

{/* md and up: the page splits into three zones meeting at one point — Cloud (top-left),
    Tools (bottom-left), Programming Languages (full-height right triangle). No card, no border —
    the divide is the layout. Each zone is a precise column grid, not a scatter. */}
<div class="skills-wedge hidden md:block" data-reveal>
  <div class="wedge-bg wedge-bg--cloud" aria-hidden="true"></div>
  <div class="wedge-bg wedge-bg--tools" aria-hidden="true"></div>
  <div class="wedge-center" aria-hidden="true"></div>

  {
    wedgeSections.map((section, s) => (
      <div class={`wedge-content wedge-content--${['lang', 'cloud', 'tools'][s]}`}>
        <h3 class="skill-section-title font-sans text-sm font-semibold uppercase tracking-wide text-muted">
          {section.group}
        </h3>
        <div class="wedge-grid" style={`grid-template-columns: repeat(${section.columns.length}, 1fr);`}>
          {section.columns.map((col, c) =>
            col.items.map(({ item, icon }, i) => (
              <button
                type="button"
                data-skill
                aria-pressed="false"
                aria-label={`${item} — ${section.group}`}
                class="skill-card skill-card--wedge"
                style={`grid-column: ${c + 1}; grid-row: ${col.rows[i]};`}
              >
                <span class="skill-face skill-face--front" aria-hidden="true">
                  {icon?.kind === 'svg' ? (
                    <svg viewBox="0 0 24 24" fill="currentColor" class="skill-icon" set:html={`<path d="${icon.path}" />`} />
                  ) : icon?.kind === 'image' ? (
                    <img src={icon.src} alt="" class="skill-icon skill-icon--image" loading="lazy" />
                  ) : (
                    <span class="skill-fallback">{badgeLabel(item)}</span>
                  )}
                </span>
                <span class="skill-face skill-face--back" aria-hidden="true">
                  <span class="skill-name">{displayName(item)}</span>
                  <span class="skill-group">{section.group}</span>
                </span>
              </button>
            )),
          )}
        </div>
      </div>
    ))
  }
</div>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-skill]');
    if (!button) return;
    const isOpen = button.getAttribute('aria-pressed') === 'true';
    button.setAttribute('aria-pressed', String(!isOpen));
  });
</script>

<style>
  .skill-cell {
    perspective: 900px;
    display: flex;
    justify-content: center;
  }

  .skill-card {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    transform-style: preserve-3d;
    transition: transform 260ms cubic-bezier(0.77, 0, 0.175, 1);
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .skill-card {
      width: 5rem;
      height: 5rem;
    }
  }

  .skill-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 9999px;
    border: 2px solid var(--color-line);
    background: var(--color-surface);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .skill-face--back {
    transform: rotateY(180deg);
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.4rem;
    text-align: center;
  }

  .skill-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .skill-icon {
      width: 2rem;
      height: 2rem;
    }
  }

  .skill-icon--image {
    width: 80%;
    height: 80%;
    object-fit: contain;
  }

  .skill-fallback {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .skill-fallback {
      font-size: 0.875rem;
    }
  }

  .skill-name {
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .skill-group {
    font-family: var(--font-sans);
    font-size: 0.45rem;
    line-height: 1.1;
    opacity: 0.85;
  }

  @media (min-width: 640px) {
    .skill-name {
      font-size: 0.7rem;
    }
    .skill-group {
      font-size: 0.55rem;
    }
  }

  .skill-card[aria-pressed='true'] {
    transform: rotateY(180deg);
  }

  .skill-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 9999px;
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-card:hover {
      transform: rotateY(180deg);
    }
  }

  /* --- Wedge layout (md and up) ---
     The page splits into three zones meeting at one point on the left-middle edge (at VX):
     Cloud (top-left), Tools (bottom-left) — both trapezoids — and Programming Languages, a
     triangle spanning the full height on the right. No card/border around it — the divide
     itself is the layout. Backgrounds are purely decorative and unclipped from content, so
     nothing gets cut off; content boxes are sized to match the zones underneath. */
  .skills-wedge {
    --vx: 45%;
    position: relative;
    aspect-ratio: 16 / 15;
  }

  .wedge-bg {
    position: absolute;
    inset: 0;
  }
  .wedge-bg--cloud {
    clip-path: polygon(0 0, 100% 0, var(--vx) 50%, 0 50%);
    background: var(--color-surface);
  }
  .wedge-bg--tools {
    clip-path: polygon(0 50%, var(--vx) 50%, 100% 100%, 0 100%);
    background: color-mix(in srgb, var(--color-surface) 100%, var(--color-ink) 6%);
  }

  .wedge-center {
    position: absolute;
    top: 50%;
    left: var(--vx);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    box-shadow: 0 2px 10px -4px color-mix(in srgb, var(--color-ink) 20%, transparent);
    transform: translate(-50%, -50%);
    z-index: 1;
  }
  .wedge-center::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 9999px;
    background: var(--color-accent);
    transform: translate(-50%, -50%);
  }

  .wedge-content {
    position: absolute;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .wedge-content--lang {
    top: 0;
    right: 0;
    bottom: 0;
    left: calc(var(--vx) + 1rem);
    padding: 1.5rem 1.5rem 1.5rem 0.5rem;
  }
  .wedge-content--cloud {
    top: 0;
    left: 0;
    height: 50%;
    width: calc(var(--vx) - 1rem);
    padding: 1.5rem 0.5rem 1rem 1.5rem;
  }
  .wedge-content--tools {
    bottom: 0;
    left: 0;
    height: 50%;
    width: calc(var(--vx) - 1rem);
    padding: 1rem 0.5rem 1.5rem 1.5rem;
  }

  .wedge-grid {
    flex: 1;
    display: grid;
    grid-template-rows: repeat(5, 1fr);
    align-items: center;
    justify-items: center;
    row-gap: 0.5rem;
    column-gap: 0.85rem;
  }

  .skill-card--wedge {
    width: 2.85rem;
    height: 2.85rem;
  }
  .skill-card--wedge .skill-icon {
    width: 1.25rem;
    height: 1.25rem;
  }
  .skill-card--wedge .skill-name {
    font-size: 0.5rem;
  }
  .skill-card--wedge .skill-group {
    font-size: 0.4rem;
  }

  @media (min-width: 1024px) {
    .skills-wedge {
      aspect-ratio: 16 / 11;
    }
    .skill-card--wedge {
      width: 3.25rem;
      height: 3.25rem;
    }
    .skill-card--wedge .skill-icon {
      width: 1.4rem;
      height: 1.4rem;
    }
  }
</style>
