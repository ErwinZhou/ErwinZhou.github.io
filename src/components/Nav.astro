---
import { NAV, SITE } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-bg/85 backdrop-blur-md">
  <nav class="shell flex h-16 items-center justify-between gap-2 sm:gap-4" aria-label="Primary">
    <a href="/" class="shrink-0 font-sans text-sm font-semibold tracking-tight whitespace-nowrap text-ink">
      {SITE.name}<span class="hidden text-muted sm:inline"> · {SITE.altName}</span>
    </a>

    <ul class="flex shrink-0 items-center gap-0.5 font-sans text-sm sm:gap-1">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-full px-2 py-1.5 transition-colors hover:text-ink sm:px-3',
                isActive(item.href) ? 'text-ink' : 'text-muted',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
