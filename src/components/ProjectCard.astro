---
import Tag from './Tag.astro';
import ProjectVisual from './ProjectVisual.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  stack?: string[];
  github?: string;
  demo?: string;
}
const { href, title, summary, stack = [], github, demo } = Astro.props;
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface/40 transition-colors hover:border-accent/40">
  <ProjectVisual slug={href.split('/').filter(Boolean).at(-1) ?? ''} compact />
  <div class="flex flex-1 flex-col p-6">
  <h3 class="text-xl tracking-tight">
    <a href={href} class="after:absolute after:inset-0">
      {title}
    </a>
  </h3>
  <p class="mt-2 flex-1 font-sans text-sm leading-relaxed text-muted">{summary}</p>

  {
    stack.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {stack.slice(0, 5).map((s) => <Tag label={s} />)}
      </div>
    )
  }

  <div class="relative z-10 mt-5 flex gap-4 font-sans text-xs text-muted">
    <span class="text-accent-ink transition-transform group-hover:translate-x-0.5">Read more →</span>
    {github && <a href={github} class="hover:text-ink" rel="noopener">GitHub</a>}
    {demo && <a href={demo} class="hover:text-ink" rel="noopener">Live demo</a>}
  </div>
  </div>
</article>
